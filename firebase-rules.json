{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$room": {
        ".read": "auth != null && $room.matches(/^[a-f0-9]{32}$/)",
        "ownerUid": {
          ".write": "auth != null && $room.matches(/^[a-f0-9]{32}$/) && !data.exists() && newData.val() === auth.uid",
          ".validate": "newData.isString() && newData.val() === auth.uid"
        },
        "state": {
          ".write": "auth != null && root.child('rooms').child($room).child('ownerUid').val() === auth.uid",
          ".validate": "newData.hasChildren(['queue','volume','version']) && newData.child('queue').isString() && newData.child('volume').isNumber() && newData.child('version').isNumber()"
        },
        "commands": {
          "$command": {
            ".write": "auth != null && root.child('rooms').child($room).child('ownerUid').exists() && ((!data.exists() && newData.exists() && newData.child('uid').val() === auth.uid && newData.child('cmd').val().matches(/^(add|remove|up|play|next|toggle|volume)$/)) || (!newData.exists() && root.child('rooms').child($room).child('ownerUid').val() === auth.uid))",
            ".validate": "newData.hasChildren(['cmd','uid','createdAt']) && newData.child('createdAt').isNumber()"
          }
        }
      }
    }
  }
}